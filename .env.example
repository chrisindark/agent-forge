# Echo Gate gateway (SPEC §10)
GATEWAY_URL=http://localhost:8000
GATEWAY_API_KEY=eg_replace_me

# Agent / model
AGENT_PROVIDER=groq
AGENT_MODEL=openai/gpt-oss-20b
AGENT_TENANT_ID=acme
